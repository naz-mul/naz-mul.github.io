{
  "name": "nalam.me",
  "version": "2.0.0",
  "description": "Personal site of Nazmul Alam",
  "author": "Naz Alam <hello@nalam.me>",
  "repository": "git@github.com:naz-mul/naz-mul.github.io.git",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.17.0",
  "engines": {
    "npm": "please-use-yarn",
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check && tsc --noEmit",
    "build": "yarn verify && yarn build:static && yarn prepare:public",
    "build:static": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "node scripts/serve-public.mjs",
    "typecheck": "yarn check",
    "check:contrast": "python3 scripts/check-contrast.py",
    "verify": "yarn check && yarn check:contrast && yarn test:unit",
    "legacy:build": "yarn clean && yarn sync:static && tsc --noEmit && vite build && yarn prerender",
    "prerender": "vite build --config vite.prerender.config.ts && node .prerender/prerender.mjs && rm -rf .prerender",
    "sync:static": "mkdir -p fonts && cp -f src/public/fonts/*.woff2 fonts/",
    "clean": "rm -rf assets",
    "prepare:public": "node scripts/prepare-public.mjs --write-hosting-csp",
    "publish:root": "node scripts/publish-root.mjs",
    "test:content": "node --test src/content/publication.test.ts src/content/showcase.test.ts",
    "test:firebase": "node --test src/lib/firebase/browser.test.ts",
    "test:publication": "node --test scripts/publication/publication.test.mjs",
    "test:preview-server": "node --test scripts/serve-public.test.mjs",
    "test:contrast": "python3 -m unittest discover -s tests -p test_contrast.py",
    "test:unit": "yarn test:content && yarn test:firebase && yarn test:publication && yarn test:preview-server && yarn test:contrast",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.3",
    "@astrojs/react": "7.0.1",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "13.0.0",
    "lucide-react": "^1.37.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "es-module-lexer": "3.0.4",
    "parse5": "8.0.1",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
