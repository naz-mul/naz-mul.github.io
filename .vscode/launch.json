{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open nalam.me (Astro dev)",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:3000",
      "webRoot": "${workspaceFolder}/src",
      "preLaunchTask": "dev: Astro"
    },
    {
      "name": "Open nalam.me (validated public artifact)",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:4173",
      "webRoot": "${workspaceFolder}/dist/public",
      "preLaunchTask": "preview: public artifact"
    },
    {
      "name": "Attach: already running dev server",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:3000",
      "webRoot": "${workspaceFolder}/src"
    }
  ]
}
