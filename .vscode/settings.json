{
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.exclude": {
    "node_modules": true,
    ".yarn": true
  },
  "search.exclude": {
    "node_modules": true,
    "yarn.lock": true,
    "assets": true,
    "index.html": true,
    "404.html": true,
    "work": true
  },
  "editor.formatOnSave": false,
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "html.format.wrapLineLength": 100,
  "[typescriptreact]": {
    "editor.tabSize": 2
  },
  "[typescript]": {
    "editor.tabSize": 2
  }
}
